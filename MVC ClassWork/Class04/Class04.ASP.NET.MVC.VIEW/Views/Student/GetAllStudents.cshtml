@model IEnumerable<Class04.ASP.NET.MVC.VIEW.Models.Dto.StudentWithCourseDto>
<h1>Get All Students</h1>
<p>
    <a>Create New Student</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Date of Birth</th>
            <th>Active Course</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.FullName</td>
                <td>@student.Age</td>
                <td>@student.NameOfCourse</td>
                <td>@Html.ActionLink("Details", "GetStudentById", new {id = student.Id})</td>
            </tr>
        }
    </tbody>
</table>