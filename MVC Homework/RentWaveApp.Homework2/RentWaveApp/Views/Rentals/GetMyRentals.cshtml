@model List<RentalVM>

<h2 class="mb-3">My Rentals</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Movie</th>
            <th>Rented On</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model)
        {
            <tr>
                <td>@rental.MovieTitle</td>
                <td>@rental.RentedOn.ToShortDateString()</td>
                <td>
                    <form asp-action="Return" asp-route-rentalId="@rental.RentalId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-warning">Return</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
    <a asp-controller="Movies" asp-action="GetAllMovies" class="btn btn-outline-secondary mb-3">Back to Movies</a>
</table>